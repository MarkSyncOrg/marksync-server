# Host port the API is published on.
MARKSYNC_PORT=8080

# Time zone used by Watchtower's logs and schedule.
TZ=Europe/Rome

# Seconds between Watchtower checks for new images.
WATCHTOWER_POLL_INTERVAL=300

# docker login credentials file of the user running docker (created by `docker login ghcr.io`).
DOCKER_CONFIG_JSON=/root/.docker/config.json
